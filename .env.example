# Example values only. Never commit .env.local or any real customer records.
# Find these in Supabase -> Project Settings -> API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional, disabled by default until SEC/OLP and privacy readiness have been confirmed.
COVE_APPLICATION_INTAKE_ENABLED=false
COVE_PRIVACY_NOTICE_VERSION=UNAPPROVED
COVE_PRIVACY_NOTICE_URL=https://your-approved-public-privacy-notice.example/borrower-privacy
COVE_ALLOW_NEW_WORKSPACE_SIGNUP=true
